# MongoDB Database
MONGODB_URI=mongodb://localhost:27017/alokworld

# JWT Authentication for Admin
JWT_SECRET=super_secret_jwt_key_change_in_production_alokworld_2026

# Admin Default Credentials (used during initial admin seeding)
